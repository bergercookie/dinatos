# Copy to `.env` (untracked) to override defaults for local development.
# See `config.py` for the full list and their defaults -- there's nothing
# required here; every setting has a sensible default.

DINATOS_DATABASE_URL=postgresql+asyncpg://dinatos:dinatos@localhost:5432/dinatos

# Optional: creates this account (as admin) on startup if it doesn't
# already exist -- see config.py's `admin_email`/`admin_password`.
# DINATOS_ADMIN_EMAIL=you@example.com
# DINATOS_ADMIN_PASSWORD=change-me

# Optional: leave unset (the default) and an admin turns self-registration on
# or off in Settings -> Administration; it is on until they do.
# Set it to true or false to decide here instead. The variable then overrides
# the admin's switch, the switch is locked in the app, and the server logs a
# warning at startup. "false" hides the login screen's "Register" link and
# rejects POST /auth/register (except for the very first, admin, account).
# Admins can still create accounts from Settings -> Administration.
# DINATOS_ALLOW_REGISTRATION=false

# The built-in MCP server (/mcp, for AI assistants). On by default; set to
# false to turn it off entirely: /mcp then answers 404.
# DINATOS_MCP_ENABLED=false

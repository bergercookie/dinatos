# Copy to .env next to docker-compose.yml. Keep .env out of version control.

# Postgres credentials -- shared between the postgres and backend services.
POSTGRES_USER=dinatos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dinatos

# Optional: creates this account (as admin) on the backend's first startup
# if it doesn't already exist yet, so there's something to log in with
# without a manual `curl -X POST /auth/register` first. Safe to leave
# both commented out on an instance that already has an account -- this
# never touches an existing user's password.
# DINATOS_ADMIN_EMAIL=you@example.com
# DINATOS_ADMIN_PASSWORD=change-me

# Optional: set to false to hide the login screen's "Register" link and
# reject POST /auth/register (except for the very first, admin, account).
# Admins can still create accounts from Profile -> Administration.
# DINATOS_ALLOW_REGISTRATION=false

# Optional: exercise tutorials (a GIF plus instructions/muscles/equipment)
# come from your own WorkoutX (https://workoutxapp.com) account instead of
# the bundled free-exercise-db dataset -- sign up there for a free API key.
# Unset (the default) needs no signup and no network access at all.
# DINATOS_WORKOUTX_API_KEY=wx_...

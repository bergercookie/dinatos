# The documentation site: Markdown source, rendered with Sphinx + MyST.
#
# Self-sufficient: `cd docs && just docs` works on its own. Imported by the
# root justfile as the `docs` module.
set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# Build the documentation site. Warnings are errors.
docs:
    uv run --project ../backend --group docs sphinx-build -W --keep-going -b html . _build/html
    @echo "Open docs/_build/html/index.html"

# Serve on http://127.0.0.1:8000 and rebuild + reload the browser on every edit.
# index.md and development/index.md include ../README.md and ../CONTRIBUTING.md,
# which are outside this folder, so they (and the screenshots the README shows)
# are watched explicitly. Warnings do not stop it here; `just docs docs` is the
# strict build CI runs.
docs-serve:
    uv run --project ../backend --group docs sphinx-autobuild . _build/html \
        --host 127.0.0.1 --port 8000 \
        --watch ../README.md --watch ../CONTRIBUTING.md --watch ../screenshots \
        --ignore '**/_build/**'

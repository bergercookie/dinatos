# Generates the screenshots this README embeds, against a real, throwaway
# backend (a disposable Postgres via testcontainers) and a real frontend
# build -- not mocked data, not a hand-maintained fixture.
#
# Self-sufficient: `cd screenshots && just generate` works on its own. Imported
# by the root justfile as the `screenshots` module.
set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# Fetch/refresh the Python side (playwright + testcontainers) and the browser Playwright drives.
install:
    uv sync --project ../backend --group screenshots
    uv run --project ../backend --group screenshots playwright install --with-deps chromium

# mypy --strict on generate.py (needs this package's own group; ruff already covers it via the shared hook).
lint:
    uv run --project ../backend --group screenshots mypy --strict generate.py

# Regenerate and overwrite the committed PNGs/README embed -- review the diff, then commit.
generate:
    uv run --project ../backend --group screenshots python generate.py
